DB_URL=jdbc:postgresql://localhost:5432/leather_db
DB_USERNAME=leather
DB_PASSWORD=leather_dev_pass
# Or use a single URL (Railway style) — JDBC conversion is automatic:
# DATABASE_URL=postgresql://leather:leather_dev_pass@localhost:5432/leather_db

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

FILE_STORAGE_PATH=./uploads
FILE_STORAGE_URL=/uploads

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SERVER_PORT=8080
# Railway sets PORT automatically — leave unset locally unless needed

SEED_DATA=true
JPA_DDL_AUTO=update

# Optional absolute API URL used in generated links (leave blank locally)
PUBLIC_API_BASE_URL=
